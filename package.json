{
  "name": "myobsidian",
  "productName": "Graphite",
  "version": "1.1.48",
  "description": "Graphite: a local-first notebook for studying",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "icon": "electron build/make-icon.js",
    "dist": "node scripts/bump-version.js && electron-builder --win && node scripts/legacy-installer-name.js",
    "publish": "node scripts/publish-github.js",
    "icons": "node scripts/make-icons.js"
  },
  "author": "MistZero",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@noble/hashes": "1.8.0",
    "htmlparser2": "9.1.0",
    "ical.js": "2.2.1",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "lucide-static": "^1.69.0",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "moment": "^2.31.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.myobsidian.app",
    "productName": "Graphite",
    "copyright": "© 2026 MistZero · Co-author: Claude",
    "electronLanguages": [
      "en-US",
      "fr",
      "es",
      "ja",
      "ko",
      "zh-CN",
      "zh-TW"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server.js",
      "code-assistant.js",
      "code-projects.js",
      "new-file.js",
      "note-links.js",
      "canvas-*.js",
      "agent.js",
      "extensions/**",
      "frameworks.js",
      "profile.js",
      "public/**",
      "build/icon.png",
      "package.json",
      "!node_modules/lucide-static/{font,dist,sprite.svg,icon-nodes.json,tags.json}",
      "!node_modules/lucide-static/**/*.map",
      "!node_modules/pdfjs-dist/{legacy,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "sample-vault",
        "to": "sample-vault",
        "filter": [
          "**/*",
          "**/.*",
          "**/.*/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Graphite",
      "artifactName": "Graphite-Setup-${version}.${ext}"
    }
  },
  "myobsidian": {
    "updateFolder": "D:\\MyObsidian\\dist"
  },
  "graphite": {
    "updateRepo": "baylorinf/Graphite"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baylorinf/Graphite.git"
  }
}
